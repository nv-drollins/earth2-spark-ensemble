# earth2-spark-ensemble cluster configuration
# Copy to cluster.conf and edit. cluster.conf is gitignored -- never commit
# site-specific hostnames or IPs.

# Space-separated SSH targets, one per Spark.
# The FIRST entry is the build node (where the image is built and exported).
#
# Prefer NAMES over IPs -- an ssh_config alias, or the Spark's own mDNS name
# (`hostname`.local, e.g. spark-6b64.local, which works out of the box on the
# same LAN). IPs hardcode a DHCP lease into your config: they go stale on a
# reboot or a new venue, and every script then fails with a confusing SSH
# error. Names survive that.
#
# Do NOT list the workstation here -- this is the compute roster. Listing it
# schedules ensemble members onto the machine that is supposed to be driving
# the display.
NODES="user@spark-1.local user@spark-2.local user@spark-3.local"

# Image name:tag produced by scripts/build.sh
IMAGE="earth2-spark:1.0"

# Where the offline bundle (image tarball + model weights) is staged on each
# node. Needs ~25 GB free: 14 GB tarball + ~7 GB weights + headroom.
BUNDLE_DIR="$HOME/e2dist"

# Host dir bind-mounted to /root/.cache in the container. Model weights and
# downloaded initial conditions live here so they survive container restarts.
CACHE_DIR="$HOME/e2cache"

# NGC base image. Must be a linux/arm64 manifest for GB10.
BASE_IMAGE="nvcr.io/nvidia/physicsnemo/physicsnemo:26.08"

# Pinned component refs -- see docs/PITFALLS.md before changing ANY of these.
E2S_VERSION="0.18.0"
MAKANI_REF="main"
TH_REF="v0.9.2"
