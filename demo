#!/usr/bin/env bash
# Show-floor control. ONE command for every booth action.
#
#   ./demo start      bring the whole demo up
#   ./demo stop       shut it down cleanly
#   ./demo status     what is running, what is not
#   ./demo check      pre-show readiness (run this the night before)
#   ./demo restart    stop + start
#
# Deliberately boring and idempotent: re-running any verb is safe, and every
# step reports what it did rather than assuming it worked.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/scripts/common.sh"

PORT="${E2_PORT:-8500}"
SBX="${E2_SANDBOX:-e2-agent}"
LLM="${E2_VLLM_CONTAINER:-e2-llm}"

_agent_node() {
  [[ -n "${E2_AGENT_NODE:-}" ]] && { echo "$E2_AGENT_NODE"; return; }
  for n in "${NODE_ARR[@]}"; do
    on_node "$n" "command -v nemoclaw >/dev/null" 2>/dev/null && { echo "$n"; return; }
  done
}

cmd_status() {
  hdr "Display server (this machine)"
  if curl -s -o /dev/null --max-time 3 "http://127.0.0.1:${PORT}/api/state" 2>/dev/null; then
    ok "serving on port $PORT"
    ip -4 -br addr 2>/dev/null | awk '$1!="lo" && $2=="UP" {split($3,a,"/");
      if (a[1]!="") print "         display : http://" a[1] ":'"${PORT}"'/display"}'
    ip -4 -br addr 2>/dev/null | awk '$1!="lo" && $2=="UP" {split($3,a,"/");
      if (a[1]!="") print "         operator: http://" a[1] ":'"${PORT}"'/operator"}'
    curl -s --max-time 3 "http://127.0.0.1:${PORT}/api/state" | python3 -c '
import json,sys
d = json.load(sys.stdin); m = d["manifest"]
c = m.get("curve") or [{}]
print(f"         {len(m.get(\"members\",[]))} members, "
      f"{(m.get(\"n_lead\",1)-1)*6}h horizon, "
      f"spread {c[0].get(\"mean_K\",\"?\")} -> {c[-1].get(\"mean_K\",\"?\")} K")
print(f"         corrdiff: {\"yes\" if \"corrdiff\" in m else \"no\"}")' 2>/dev/null
  else
    err "not running  (./demo start)"
  fi

  hdr "Forecast nodes"
  for n in "${NODE_ARR[@]}"; do
    local img free
    img=$(on_node "$n" "docker image inspect '$IMAGE' >/dev/null 2>&1 && echo yes || echo no" 2>/dev/null | tr -d '\r')
    free=$(on_node "$n" "free -g | awk '/Mem/{print \$7}'" 2>/dev/null | tr -d '\r')
    if [[ "$img" == "yes" ]]; then
      if [[ -n "$free" && "$free" -ge 24 ]]; then
        ok "$n  image ready, ${free}G free -- will run members"
      else
        warn "$n  image ready, only ${free:-?}G free -- will be SKIPPED for members"
      fi
    else
      err "$n  image MISSING  (./scripts/distribute.sh)"
    fi
  done

  hdr "Agent"
  local an; an=$(_agent_node)
  if [[ -z "$an" ]]; then
    warn "no node has nemoclaw -- agent features disabled (demo still works)"
  else
    local model
    model=$(on_node "$an" "curl -s --max-time 5 http://127.0.0.1:8000/v1/models" 2>/dev/null \
            | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null)
    [[ -n "$model" ]] && ok "$an  serving $model" || err "$an  LLM not responding  (./agent/serve-model.sh on that node)"
    on_node "$an" "openshell sandbox list 2>/dev/null | grep -q '^$SBX .*Ready'" 2>/dev/null \
      && ok "$an  sandbox '$SBX' Ready" \
      || warn "$an  sandbox '$SBX' not Ready  (./agent/setup-agent.sh)"
  fi
}

cmd_start() {
  hdr "Starting the demo"

  # 1. The LLM takes minutes to load, so kick it off FIRST and check it last.
  local an; an=$(_agent_node)
  if [[ -n "$an" ]]; then
    if on_node "$an" "docker ps --format '{{.Names}}' | grep -q '^${LLM}\$'" 2>/dev/null; then
      ok "agent LLM already running on $an"
    else
      echo "  starting agent LLM on $an (loads in ~4-6 min, in the background)"
      # Ship the serve script each time so the node never runs a stale copy.
      scp -o BatchMode=yes -q "$HERE/agent/serve-model.sh" "$an:~/serve-model.sh" 2>/dev/null
      on_node "$an" "nohup bash ~/serve-model.sh >/tmp/e2-llm.log 2>&1 & disown" 2>/dev/null \
        || warn "could not auto-start the LLM -- run ./agent/serve-model.sh on $an"
    fi
  fi

  # 2. Display server. This is the part the booth actually needs.
  bash "$HERE/viz/start-display.sh" || { err "display failed to start"; return 1; }

  echo
  c_grn "Demo is up. Put /display on the big screen and keep /operator on your laptop."
  echo "  If the agent panel errors, the LLM is probably still loading -- give it a few"
  echo "  minutes and check with: ./demo status"
}

cmd_stop() {
  hdr "Stopping the demo"
  bash "$HERE/viz/stop-display.sh"
  # Leave the LLM and sandbox UP by default: they take minutes to come back and
  # cost nothing idle. --all tears them down too.
  if [[ "${1:-}" == "--all" ]]; then
    local an; an=$(_agent_node)
    if [[ -n "$an" ]]; then
      on_node "$an" "docker rm -f '$LLM' >/dev/null 2>&1" && ok "agent LLM stopped on $an"
    fi
  else
    echo "  (agent LLM left running -- it takes ~5 min to reload. Use --all to stop it too.)"
  fi
}

cmd_check() {
  hdr "Pre-show check"
  bash "$HERE/scripts/preflight.sh" || return 1
  bash "$HERE/scripts/verify.sh"    || return 1
  local n
  n=$(ls "$HOME/e2viz/frames"/manifest.json 2>/dev/null | wc -l)
  [[ "$n" -eq 1 ]] && ok "rendered frames present" \
                   || warn "no rendered frames -- run ./scripts/ensemble.sh then viz/render.py"
  cmd_status
}

case "${1:-status}" in
  start)   cmd_start ;;
  stop)    shift; cmd_stop "${1:-}" ;;
  restart) cmd_stop; sleep 2; cmd_start ;;
  status)  cmd_status ;;
  check)   cmd_check ;;
  *) echo "usage: ./demo {start|stop [--all]|restart|status|check}"; exit 1 ;;
esac
